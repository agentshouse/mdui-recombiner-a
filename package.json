{
  "name": "house-book-recombiner",
  "version": "0.1.0",
  "description": "",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "npm run prepare && vite build",
    "lint": "biome lint src tests scripts && biome check --formatter-enabled=false --linter-enabled=false src",
    "format": "biome check --write src tests scripts",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "prepare": "node scripts/prepare-release.mjs",
    "release:check": "node scripts/check-release.mjs",
    "licenses:check": "node scripts/generate-notices.mjs --check",
    "starter:check": "node scripts/check-starter.mjs",
    "verify": "npm run typecheck && npm run lint && npm test && npm run starter:check && npm run build && npm run release:check && npm run licenses:check",
    "publish": "node publish.mjs"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@agentshouse/mdmodel": "0.1.0-c6e675bb19980",
    "@biomejs/biome": "1.9.4",
    "@types/node": "22.14.1",
    "autoprefixer": "10.4.21",
    "babel-preset-solid": "1.9.5",
    "postcss": "8.5.3",
    "tailwindcss": "3.4.17",
    "tailwindcss-animate": "1.0.7",
    "typescript": "5.8.3",
    "vite": "6.3.2",
    "vite-plugin-solid": "2.11.6",
    "vite-tsconfig-paths": "5.1.4"
  },
  "dependencies": {
    "@agentshouse/app-bridge": "0.1.0-cc70c9b07c3ec",
    "@kobalte/core": "0.13.9",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "solid-js": "1.9.5",
    "tailwind-merge": "3.2.0",
    "yaml": "2.7.1"
  },
  "engines": {
    "node": ">=24.21.0"
  },
  "overrides": {
    "babel-preset-solid": "1.9.5"
  }
}
